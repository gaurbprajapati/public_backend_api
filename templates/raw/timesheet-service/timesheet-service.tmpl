[Unit]
Description=timesheet-microservice
After=syslog.target network.target
StartLimitBurst=10
StartLimitIntervalSec=60

[Service]
User=webapp
Group=webapp

Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64"
ExecStart=/usr/lib/jvm/java-21-openjdk-arm64/bin/java -XX:InitialRAMPercentage=${JVM_INITIAL_HEAP_PERCENTAGE} -XX:MaxRAMPercentage=${JVM_MAX_HEAP_PERCENTAGE} -jar /var/www/html/timesheet-microservice.jar --spring.config.location=/var/www/html/application.properties
SuccessExitStatus=143
TimeoutStopSec=30
Restart=on-failure
StartLimitBurst=2
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target