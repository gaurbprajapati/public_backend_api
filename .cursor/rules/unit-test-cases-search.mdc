### 3. NodeFactory Testing Strategy

#### 3.1 NodeFactory Test Pattern

**NodeFactory creates filter nodes based on filter type and dbField:**

```java
@ExtendWith({ SpringExtension.class, MockitoExtension.class })
class NodeFactoryTests {
    
    private NodeFactory nodeFactory;
    private final Integer accountId = 1;
    private final String gmtDifference = "+05:30";
    
    @BeforeEach
    void setUp() {
        this.nodeFactory = new NodeFactory(this.accountId, this.gmtDifference);
    }
    
    @Test
    @DisplayName("Create filter node should create correct filter node for timesheet period IS_LESS_THAN")
    void testCreateFilterNodeTimesheetPeriodIsLessThanCreatesCorrectNode() {
        // Given
        FilterDto filterDto = new FilterDto();
        filterDto.setDbField("timesheetPeriod");
        filterDto.setFilterType(FilterTypes.IS_LESS_THAN);
        filterDto.setFilterValue("10");
        filterDto.setGroupType("AND");
        
        // When
        FilterNode filterNode = this.nodeFactory.createFilterNode(filterDto);
        
        // Then
        assertThat(filterNode).isNotNull();
        assertThat(filterNode.getFilterNodeImpl().getClass().getSimpleName()).isEqualTo("IsLessThanFilterNode");
    }
    
    @Test
    @DisplayName("Create filter node should create correct filter node for timesheet period IS_MORE_THAN")
    void testCreateFilterNodeTimesheetPeriodIsMoreThanCreatesCorrectNode() {
        // Given
        FilterDto filterDto = new FilterDto();
        filterDto.setDbField("timesheetPeriod");
        filterDto.setFilterType(FilterTypes.IS_MORE_THAN);
        filterDto.setFilterValue("10");
        filterDto.setGroupType("AND");
        
        // When
        FilterNode filterNode = this.nodeFactory.createFilterNode(filterDto);
        
        // Then
        assertThat(filterNode).isNotNull();
        assertThat(filterNode.getFilterNodeImpl().getClass().getSimpleName()).isEqualTo("IsMoreThanFilterNode");
    }
    
    @Test
    @DisplayName("Create filter node should set accountId and gmtDifference in FilterNodeContext")
    void testCreateFilterNodeSetsContext() {
        // Given
        FilterDto filterDto = new FilterDto();
        filterDto.setDbField("added_on");
        filterDto.setFilterType(FilterTypes.IS);
        filterDto.setFilterValue("TODAY");
        filterDto.setGroupType("AND");
        
        // When
        FilterNode result = this.nodeFactory.createFilterNode(filterDto);
        
        // Then
        assertThat(result).isNotNull();
        assertThat(result.getFilterNodeContext().getAccountId()).isEqualTo(this.accountId);
        assertThat(result.getFilterNodeContext().getGmtDifference()).isEqualTo(this.gmtDifference);
        assertThat(result.getFilterNodeContext().getFilterDto()).isEqualTo(filterDto);
    }
    
    @Test
    @DisplayName("Create filter node should throw exception for unknown dbField")
    void testCreateFilterNodeUnknownDbFieldThrowsException() {
        // Given
        FilterDto filterDto = new FilterDto();
        filterDto.setDbField("unknown_field");
        filterDto.setFilterType(FilterTypes.IS);
        filterDto.setFilterValue("test");
        filterDto.setGroupType("AND");
        
        // When & Then
        assertThatThrownBy(() -> this.nodeFactory.createFilterNode(filterDto))
            .isInstanceOf(IllegalArgumentException.class)
            .hasMessageContaining("Unknown dbField");
    }
    
    @Test
    @DisplayName("Create group conjoint node should create GroupANDNode for AND operator")
    void testCreateGroupConjointNodeForAND() {
        // Given
        // When
        GroupConjointNode result = this.nodeFactory.createGroupConjointNode("AND");
        
        // Then
        assertThat(result).isNotNull();
        assertThat(result).isInstanceOf(GroupANDNode.class);
    }
    
    @Test
    @DisplayName("Create group conjoint node should create GroupORNode for OR operator")
    void testCreateGroupConjointNodeForOR() {
        // Given
        // When
        GroupConjointNode result = this.nodeFactory.createGroupConjointNode("OR");
        
        // Then
        assertThat(result).isNotNull();
        assertThat(result).isInstanceOf(GroupORNode.class);
    }
    
    @Test
    @DisplayName("Create group conjoint node should handle case-insensitive matching")
    void testCreateGroupConjointNodeCaseInsensitiveMatching() {
        // Given
        // When
        GroupConjointNode result = this.nodeFactory.createGroupConjointNode("and");
        
        // Then
        assertThat(result).isNotNull();
        assertThat(result).isInstanceOf(GroupANDNode.class);
    }
}
```

