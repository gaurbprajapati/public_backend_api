import java.util.Base64

pipeline {
    agent {
        label 'agent-java21'
    }

    environment {
        SONAR_TOKEN = credentials('sonar-token')
        CHANNEL_ID = "C073YKH0Q8P"
        AWS_REGION = 'ap-south-1'
        DOMAIN = 'recruitcrm'
        DOMAIN_OWNER = '004468257635'
        JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_DOMAIN = 'recruitcrm'
        JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_ID = 'java-packages'
        AWS_CODEARTIFACT_REPOSITORY_USERNAME = 'aws'
        JAVA_PACKAGES_CODEARTIFACT_REPOSITORY_URL = 'https://recruitcrm-004468257635.d.codeartifact.ap-south-1.amazonaws.com/maven/java-packages/'
    }

    parameters {
        string(name: 'accountId', defaultValue: '459515', description: 'application-test.properties')
        string(name: 'userId', defaultValue: '459515', description: 'application-test.properties')
    }
 
    stages {
        stage('Update Branches') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'git-cli-credential', usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_TOKEN')]) {
                    sh("""
                        git config --global credential.helper 'store --file=.git/credentials'
                        echo "https://$GIT_USERNAME:$GIT_TOKEN@github.com" > .git/credentials
                        git fetch origin +refs/heads/*:refs/remotes/origin/*
                    """)

                    script {
                        // Fetch the latest commit SHA
                        def commitSha = sh(script: "git log -1 --pretty=format:%H", returnStdout: true).trim()
                        echo "The latest commit SHA is: ${commitSha}"
                        env.LATEST_COMMIT_SHA = commitSha

                        // Trim the commit SHA to the first 5 characters
                        def trimmedCommitSha = commitSha.take(5)
                        echo "The trimmed commit SHA is: ${trimmedCommitSha}"
                        env.TRIMMED_COMMIT_SHA = trimmedCommitSha

                        // Fetch the email of the latest committer
                        def commitEmail = sh(script: "git log -1 --pretty=format:%ae", returnStdout: true).trim()
                        echo "The email of the last committer is: ${commitEmail}"
                        env.LAST_COMMIT_EMAIL = commitEmail

                        // Set candidate branch name
                        if (env.CHANGE_ID) {
                            env.CANDIDATE_BRANCH_NAME = env.CHANGE_BRANCH
                        } else {
                            env.CANDIDATE_BRANCH_NAME = env.BRANCH_NAME
                        }
                        echo "Candidate branch name is: ${env.CANDIDATE_BRANCH_NAME}"

                        // Determine the unique environment name based on PR or commit
                        def uniqueEnvName = ""
                        if (env.CHANGE_ID) {
                            echo "Pipeline triggered by PR: ${env.CHANGE_ID}"
                            def lastTwoChars = trimmedCommitSha[-2..-1]  // Extract last 2 characters
                            uniqueEnvName = "${env.CHANGE_ID}${lastTwoChars}"
                        } else {
                            echo "Pipeline triggered by a direct commit"
                            uniqueEnvName = "${trimmedCommitSha}"
                        }
                        echo "The unique environment name is: ${uniqueEnvName}"
                        env.UNIQUE_ENV_NAME = uniqueEnvName
                    }

                }
            }
        }

        stage('Inject AWS Credentials') {
            steps {
                script {
                    // Use withCredentials to load AWS credentials into environment variables
                    withCredentials([aws(credentialsId: 'candidate-revamp-pipeline-aws-access')]) {
                        // Set credentials as global environment variables
                        env.AWS_ACCESS_KEY_ID = "${AWS_ACCESS_KEY_ID}"
                        env.AWS_SECRET_ACCESS_KEY = "${AWS_SECRET_ACCESS_KEY}"
                    }
                }
                script {
                    // Fetch the token and inject it into the environment
                    env.CODEARTIFACT_AUTH_TOKEN = sh(
                            script: """
                        aws codeartifact get-authorization-token \
                            --domain $DOMAIN \
                            --domain-owner $DOMAIN_OWNER \
                            --region $AWS_REGION \
                            --query authorizationToken \
                            --output text
                        """,
                            returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Environment Preparation') {
            environment {
                AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
                AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
                DB_HOST_READER = credentials('alphas-db-host-reader')
                DB_HOST_WRITER = credentials('alphas-db-host-writer')
                DB_USERNAME = credentials('alphas-db-username')
                DB_PASSWORD = credentials('alphas-db-password')
                DB_DATABASE = credentials('alphas-db-database')
                JWT_SECRET_KEY = credentials('alphas-albatross-jwt-secret-key')
            }
            steps {
                script {
                    withEnv(['PATH+VIRTUAL_ENV=/opt/env/bin']) {
                        sh "pip install boto3"
                        sh "python3 ./scripts/create_environment.py"
                    }

                    def propertiesList = [
                            "account-id=${params.accountId}",
                            "user-id=${params.userId}"
                    ]
                    def applicationTestProperties = propertiesList.join('\n') + '\n'
                    writeFile file: 'src/test/resources/application-test.properties', text: applicationTestProperties
                }
            sh 'printenv | sort'
            }
            
        }

        stage('Execute Tests') {
            steps {
                script {
                    withCredentials([aws(credentialsId: 'candidate-revamp-pipeline-aws-access')]) {
                        env.AWS_ACCESS_KEY_ID = "${AWS_ACCESS_KEY_ID}"
                        env.AWS_SECRET_ACCESS_KEY = "${AWS_SECRET_ACCESS_KEY}"
                    }

                    try {
                        sh "mvn -version"
                        sh "cat src/main/resources/application.properties"
                        sh "cat src/test/resources/application-test.properties"
                        sh "mvn -s settings.xml \
                                --batch-mode clean test \
                                surefire-report:report-only \
                                jacoco:report \
                                -Dsentry.maven.plugin.skip=true \
                                -Dmaven.test.failure.ignore=true"

                    } catch (Exception e) {
                        error "Unit Test Execution Failed!"
                    }
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                script {
                    // Publish the JUnit test results
                    junit '**/target/surefire-reports/TEST-*.xml'
                }
            }

            post {
                success {
                    script {
                        def buildUrl = env.BUILD_URL.replaceAll("http://jenkins-ci:8080", "http://jenkins-ci.recruitcrm.net:8080")
                        slackSend(
                                channel: "${CHANNEL_ID}",
                                color: "good",
                                message: "JUnit tests passed! See the test report at ${buildUrl}"
                        )
                    }
                }
                failure {
                    script {
                        def buildUrl = env.BUILD_URL.replaceAll("http://jenkins-ci:8080", "http://jenkins-ci.recruitcrm.net:8080")
                        slackSend(
                                channel: "${CHANNEL_ID}",
                                color: "danger",
                                message: "JUnit tests failed. See the test report at ${buildUrl}"
                        )
                    }
                }
            }
        }

        stage('PR Analysis') {
            when {
                expression {
                    if (env.CHANGE_ID != null) {
                        def validChangeTarget = ["main", "dev", "cse-bug-release" ].contains(env.CHANGE_TARGET)
                        def validBaseBranchPrefixes = ['feature-', 'bugfix-', 'bugfix-cse', 'bug-hotfix-', 'enhancement-', 'refactor-']
                        // TODO: Remove the true condition once all the current PRs are merged
                        def validChangeBranch = validBaseBranchPrefixes.any { env.CHANGE_BRANCH.startsWith(it) } || true
                        return validChangeTarget && validChangeBranch
                    }
                    return false
                }
            }
            steps {
                script {
                    def pullRequestId = env.CHANGE_ID
                    def pullRequestBranch = env.CHANGE_BRANCH
                    def baseBranch = env.CHANGE_TARGET
                    withSonarQubeEnv('default_env') {
                        sh "mvn -s settings.xml \
                                --batch-mode \
                                sonar:sonar \
                                -Dsonar.pullrequest.key=${pullRequestId} \
                                -Dsonar.pullrequest.branch=${pullRequestBranch} \
                                -Dsonar.pullrequest.base=${baseBranch} \
                                -Dmaven.test.skip=true \
                                -Dsentry.maven.plugin.skip=true"
                    }
                }
            }
        }

        stage('Branch Analysis') {
            when {
                expression {
                    def validPrefixes = ['feature-', 'bugfix-', 'bugfix-cse', 'bug-hotfix-', 'enhancement-', 'refactor-']
                    def validBranches = ['main', 'dev', 'cse-bug-release']
                    def validBranch = validPrefixes.any { env.BRANCH_NAME.startsWith(it) } || validBranches.contains(env.BRANCH_NAME)
                    return validBranch
                }
            }
            steps {
                script {
                    def currentBranch = env.BRANCH_NAME
                    def targetBranch = 'dev'
                    if (currentBranch.startsWith('bugfix-cse')) {
                        targetBranch = 'cse-bug-release'
                    } else if (currentBranch.startsWith('bug-hotfix')) {
                        targetBranch = 'main'
                    }
                    withSonarQubeEnv('default_env') {
                        sh "mvn -s settings.xml \
                                --batch-mode \
                                sonar:sonar \
                                -Dsonar.branch.name=${currentBranch} \
                                -Dsonar.branch.target=${targetBranch} \
                                -Dmaven.test.skip=true \
                                -Dsentry.maven.plugin.skip=true"
                    }
                }
            sh 'printenv | sort'
            }
        }

        stage('Send Test Report') {
            steps {                                        
                script {
                    env.COMMIT_MESSAGE = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                }
                sh "zip -r scan.zip target/site/"
                // Change here for new repository
                slackUploadFile(
                    filePath: "scan.zip",
                    credentialId: "slack-bot-token",
                    channel: "${CHANNEL_ID}",
                    initialComment: """
                            *REPOSITORY_NAME:* recruitcrm-candidate-microservice,
                            *BRANCH_NAME:* ${env.BRANCH_NAME},
                            *COMMIT_URL:* https://github.com/Workforce-Cloud-Tech/recruitcrm-candidate-microservice/commit/${env.GIT_COMMIT},
                            *COMMIT_MESSAGE:* ${env.COMMIT_MESSAGE}
                            """
                )
            
            }
        }

        stage('Provisioning env') {
            steps {
                script {
                    try {
                        def katiaYamlContent = """
globals:
  pr_branch_name: ${env.CANDIDATE_BRANCH_NAME}
""".toString()

                        // Print the content to verify structure
                        println("Katia YAML Content: ${katiaYamlContent}")

                        // Use Java's Base64 encoder
                        def katiaYamlBase64 = Base64.getEncoder().encodeToString(katiaYamlContent.getBytes('UTF-8'))

                        build job: 'katia-fractional/main', 
                            parameters: [
                                string(name: 'ENVIRONMENT_NAME', value: env.UNIQUE_ENV_NAME),
                                string(name: 'APP_ENV', value: env.UNIQUE_ENV_NAME),
                                string(name: 'KATIA_ACTION', value: 'provision'),
                                string(name: 'SELECTED_SERVICES', value: 'rds,elasticache,candidate'),
                                text(name: 'KATIA_YAML_CONFIG', value: katiaYamlBase64)
                            ], 
                            wait: true

                    } catch (Exception e) {
                        echo "Env Provisioning Failed : ${e.getMessage()}"
                    }
                    sleep(60)   
                }
            }
        }  

        stage('Check deployment Status') {
            steps {
                script {
                    def TARGET_JOB = "${env.UNIQUE_ENV_NAME}_pipelines/job/${env.UNIQUE_ENV_NAME}_orchestrator"
                    def BUILD_NUMBER = '1' 
                    def JENKINS_URL = 'https://jenkins.recruitcrm.net'
                    
                    // Method 1: Using Jenkins API
                    def statusResponse = httpRequest(
                        url: "${JENKINS_URL}/job/${TARGET_JOB}/${BUILD_NUMBER}/api/json",
                        authentication: 'jenkins-credentials-id' 
                    )
                    def pipelineStatus = readJSON text: statusResponse.content
                    
                    echo "Pipeline Status: ${pipelineStatus.result}"
                    echo "Building: ${pipelineStatus.building}"
                    
                    // Optional: Wait for pipeline to complete if it's still running
                    if(pipelineStatus.building) {
                        echo "Pipeline is still running. Waiting for completion..."
                        // Poll until the pipeline completes
                        while(true) {
                            sleep(30) // Wait 30 seconds between checks
                            statusResponse = httpRequest(
                                url: "${JENKINS_URL}/job/${TARGET_JOB}/${BUILD_NUMBER}/api/json",
                                authentication: 'jenkins-credentials-id'
                            )
                            pipelineStatus = readJSON text: statusResponse.content
                            if(!pipelineStatus.building) {
                                break
                            }
                        }
                        echo "Final Status: ${pipelineStatus.result}"
                    }
                    
                    if(pipelineStatus.result == 'FAILURE') {
                        error "Target pipeline failed!"
                    }
                }
            }
        }

        stage('Triggering Maven API Test') {
            steps {
                script {
                    try {
                        build job: 'Test_the_REST', 
                                parameters: [
                                    string(name: 'testsuite', value: 'health'),
                                    string(name: 'envname', value: env.UNIQUE_ENV_NAME),
                                    string(name: 'dbname', value: 'Test'),
                                    string(name: 'yourEmailId', value: "${env.LAST_COMMIT_EMAIL},sachi@recruitcrm.io")
                                ], 
                                wait: true
                    } catch (Exception e) {
                        error "API Test Execution Failed!"
                    }
                }
            }
        }

        stage('DeProvisioning env') {
            steps {
                script {
                    try {
                        build job: 'katia-fractional/main',  // Absolute path
                            parameters: [
                                string(name: 'ENVIRONMENT_NAME', value: env.UNIQUE_ENV_NAME),
                                string(name: 'APP_ENV', value: env.UNIQUE_ENV_NAME),
                                string(name: 'KATIA_ACTION', value: 'destroy'),
                                string(name: 'SELECTED_SERVICES', value: 'rds,elasticache,candidate')
                            ], 
                            wait: true
                    } catch (Exception e) {
                        echo "Env De-Provisioning Failed : ${e.getMessage()}"
                    }
                }
            }
        }
    } 

    post {
        failure {
            script {
                try {
                    build job: 'katia-fractional/main', 
                        parameters: [
                            string(name: 'ENVIRONMENT_NAME', value: env.UNIQUE_ENV_NAME),
                            string(name: 'APP_ENV', value: env.UNIQUE_ENV_NAME),
                            string(name: 'KATIA_ACTION', value: 'destroy'),
                            string(name: 'SELECTED_SERVICES', value: 'rds,elasticache,candidate')
                        ], 
                        wait: true
                } catch (Exception e) {
                    echo "Env De-Provisioning Failed: ${e.getMessage()}"
                }
            }
        }
    }
}
